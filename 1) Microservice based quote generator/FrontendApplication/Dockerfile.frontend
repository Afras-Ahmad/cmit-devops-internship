# --- Stage 1: Build & Dependencies ---
FROM node:22-alpine AS builder
WORKDIR /app

# Copying package files first to leverage Docker layer caching
COPY package*.json ./

# Install ALL dependencies (including devDependencies if needed for TypeScript/bundling)
RUN npm ci

# Copy application source code
COPY . .

ARG API_GATEWAY=http://localhost:3000
ENV API_GATEWAY=$API_GATEWAY

ENV NODE_OPTIONS=--openssl-legacy-provider

RUN npm run build


FROM nginx:alpine

COPY vhost.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /var/www

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]